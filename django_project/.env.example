# Copy this file to .env and fill in your own local values.
# Generate a unique Django secret key before running the application.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=arcave_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# For deployment: set DEBUG=False, a fresh secret key, and your exact domain(s).
# HTTPS redirects and secure cookies are enabled automatically outside DEBUG mode.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Enable only if your trusted proxy strips incoming X-Forwarded-Proto headers.
DJANGO_TRUST_PROXY_HTTPS=False

# Django creates and drops this separate database during tests.
# Must begin with test_ and differ from DB_NAME. The test role needs CREATEDB.
TEST_DB_NAME=test_arcave
